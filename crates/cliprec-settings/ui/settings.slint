// Finestra impostazioni di ClipRec, sul modello delle Impostazioni di Windows 11: barra laterale con
// le sezioni, pagine di schede con righe (titolo, descrizione, controllo a destra). Le stringhe
// vengono da `global T`, riempito da Rust in italiano o inglese (src/i18n.rs); la logica vive in
// Rust (src/model.rs), qui solo la vista.
import { ComboBox, SpinBox, Slider, LineEdit, Button, ScrollView, AboutSlint, Palette, Switch, Spinner, ProgressIndicator } from "std-widgets.slint";

export global T {
    in property <string> window-title;
    in property <string> app-subtitle;
    in property <string> tab-video;
    in property <string> tab-audio;
    in property <string> tab-about;
    in property <string> video-subtitle;
    in property <string> audio-subtitle;
    in property <string> about-subtitle;
    in property <string> sec-recording;
    in property <string> sec-quality;
    in property <string> sec-capture;
    in property <string> sec-tracks-short;
    in property <string> sec-length-files;
    in property <string> sec-length-format;
    in property <string> sec-shortcuts;
    in property <string> tab-audio-clip;
    in property <string> audio-clip-subtitle;
    in property <string> tab-general;
    in property <string> general-subtitle;
    in property <string> sec-sources;
    in property <string> sec-apps;
    in property <string> sec-files;
    in property <string> sec-startup;
    in property <string> sec-notify;
    in property <string> sec-memory;
    in property <string> sec-performance;
    in property <string> sec-language;
    in property <string> video-enabled;
    in property <string> video-enabled-desc;
    in property <string> video-source;
    in property <string> video-source-desc;
    in property <string> video-target;
    in property <string> target-monitor-desc;
    in property <string> target-window-desc;
    in property <string> target-game-desc;
    in property <string> video-codec;
    in property <string> video-codec-desc;
    in property <string> video-resolution;
    in property <string> video-resolution-desc;
    in property <string> video-fps;
    in property <string> video-quality;
    in property <string> video-quality-desc;
    in property <string> video-max-bitrate;
    in property <string> video-max-bitrate-desc;
    in property <string> auto;
    in property <string> native;
    in property <string> src-monitor;
    in property <string> src-window;
    in property <string> src-game;
    in property <string> pick;
    in property <string> sec-encoding;
    in property <string> color-format;
    in property <string> color-format-desc;
    in property <string> fmt-420;
    in property <string> fmt-444;
    in property <string> rate-control;
    in property <string> rate-control-desc;
    in property <string> rc-quality;
    in property <string> rc-vbr;
