export struct Form {
    video-enabled: bool,
    source-kind: int,
    source-target: string,
    codec: int,
    resolution: int,
    fps: int,
    quality: int,
    max-bitrate: string,
    color-format: int,
    rate-control: int,
    target-bitrate: string,
    preset: int,
    keyframe-seconds: int,
    b-frames: int,
    lookahead: bool,
    adaptive-quantization: bool,
    audio-bitrate: int,
    capture-cursor: bool,
    any-fullscreen: bool,
    games: string,
    audio-mode: int,
    add-mix: bool,
    audio-clip-mode: int,
    audio-clip-add-mix: bool,
    process-events: bool,
    block-exclusive: bool,
    hotkey-video: string,
    hotkey-audio: string,
    pad-video: string,
    pad-audio: string,
    video-seconds: int,
    audio-seconds: int,
    folder: string,
    template: string,
    audio-format: int,
    container: int,
    max-mb: string,
    lock-pages: bool,
    gpu-priority: int,
    language: int,
    start-with-windows: bool,
    start-as-admin: bool,
    sound: bool,
    notifications: bool,
    check-updates: bool,
}

export struct SourceRow {
    name: string,
    kind: int,
    target: string,
    volume: float,
    delay: int,
    // Posizione nel menu dei dispositivi: 0 = predefinito di Windows, -1 = non collegato.
    pick: int,
    mono: bool,
}

// Colori delle Impostazioni di Windows 11, chiari o scuri come il sistema.
global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> window: dark ? #202020 : #f3f3f3;
    out property <color> card: dark ? #2b2b2b : #fbfbfb;
    out property <color> stroke: dark ? #1d1d1d : #e5e5e5;
    out property <color> divider: dark ? #ffffff10 : #0000000d;
    out property <color> hover: dark ? #ffffff0b : #00000008;
    out property <color> selected: dark ? #ffffff12 : #0000000b;
    out property <color> text: dark ? #ffffff : #1b1b1b;
    out property <color> text-secondary: dark ? #ffffffa0 : #0000009c;
    out property <color> text-disabled: dark ? #ffffff5c : #0000005c;
    out property <color> warning: dark ? #fce100 : #9d5d00;
    out property <color> error: dark ? #ff99a4 : #c42b1c;
    out property <color> meter: dark ? #6ccb5f : #0f7b0f;
    out property <color> success: dark ? #6ccb5f : #0f7b0f;
    // Icone di sistema, presenti in Windows 10 e 11.
    out property <string> icons: "Segoe MDL2 Assets";
}

component Icon inherits Text {
    font-family: Theme.icons;
    font-size: 16px;
    color: Theme.text;
    horizontal-alignment: center;
    vertical-alignment: center;
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 40px;
    border-radius: 5px;
    background: selected ? Theme.selected : (ta.has-hover ? Theme.hover : transparent);
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    Rectangle {
        x: 0;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: Palette.accent-background;
        visible: root.selected;
    }
    HorizontalLayout {
        padding-left: 16px;
        spacing: 14px;
        Icon { text: root.icon; width: 18px; }
        Text { text: root.text; color: Theme.text; font-size: 14px; vertical-alignment: center; }
    }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: ta.has-hover && root.enabled ? Theme.selected : transparent;
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Icon {
        width: parent.width;
        height: parent.height;
        text: root.icon;
        font-size: 12px;
        color: root.enabled ? Theme.text : Theme.text-disabled;
    }
}

component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.stroke;
    VerticalLayout {
        @children
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

component SectionTitle inherits VerticalLayout {
    in property <string> text;
    padding-top: 20px;
    padding-bottom: 4px;
    Text { text: root.text; font-size: 14px; font-weight: 600; color: Theme.text; }
}

// Riga di una scheda: titolo e descrizione a sinistra, controlli a destra.
component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    in property <bool> enabled: true;
    in property <color> description-color: Theme.text-secondary;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 11px;
    padding-bottom: 11px;
    spacing: 24px;
    min-height: 60px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            font-size: 14px;
            color: root.enabled ? Theme.text : Theme.text-disabled;
            wrap: word-wrap;
        }
        if root.description != "": Text {
            text: root.description;
            font-size: 12px;
            color: root.enabled ? root.description-color : Theme.text-disabled;
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        horizontal-stretch: 0;
        @children
    }
}

// Pagina con titolo e contenuto scorrevole.
component Page inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    // La pagina non impone dimensioni alla finestra: il contenuto scorre.
    min-height: 0;
    min-width: 0;
    sv := ScrollView {
        width: parent.width;
        height: parent.height;
        content-width: self.visible-width;
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: sv.visible-width;
            padding-left: 36px;
            padding-right: 36px;
            padding-top: 28px;
            padding-bottom: 24px;
            spacing: 4px;
            alignment: start;
            Text { text: root.title; font-size: 28px; font-weight: 600; color: Theme.text; }
            Text { text: root.subtitle; font-size: 14px; color: Theme.text-secondary; wrap: word-wrap; }
            @children
        }
    }
}

// Campo che cattura la combinazione premuta mentre ha il focus. Le callback restituiscono `true`
// quando la combinazione è valida: il campo lascia il focus e mostra il tasto registrato.
component HotkeyField inherits Rectangle {
    in property <string> value;
    callback key(string, bool, bool, bool, bool) -> bool;
    callback mouse(int, bool, bool, bool, bool) -> bool;
    width: 220px;
    height: 32px;
    border-radius: 4px;
    background: Palette.control-background;
    border-width: 1px;
    border-color: fs.has-focus ? Palette.accent-background : Theme.stroke;
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                fs.clear-focus();
            } else if (root.key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta)) {
                fs.clear-focus();
            }
            accept
        }
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    fs.focus();
                    if (e.button == PointerEventButton.back) {
                        if (root.mouse(4, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta)) { fs.clear-focus(); }
                    } else if (e.button == PointerEventButton.forward) {
                        if (root.mouse(5, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta)) { fs.clear-focus(); }
                    }
                }
            }
        }
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            Icon { text: "\u{E765}"; width: 16px; font-size: 14px; color: Theme.text-secondary; }
            Text {
                text: fs.has-focus ? T.hotkey-press : (root.value == "" ? T.hotkey-empty : root.value);
                vertical-alignment: center;
                font-size: 14px;
                color: fs.has-focus ? Palette.accent-background : (root.value == "" ? Theme.text-secondary : Theme.text);
            }
        }
    }
}

// Elenco di sorgenti audio (clip video o clip solo audio), usato due volte.
component SourceList inherits VerticalLayout {
    in property <[SourceRow]> rows;
    // Livello di ogni riga per l'indicatore di volume (0-1).
    in property <[float]> levels;
    in property <[string]> app-choices;
    in property <[string]> inputs;
    in property <[string]> outputs;
    in property <bool> router-available;
    callback changed(int, SourceRow);
    callback add();
    callback remove(int);
    callback move(int, int);
    callback pick(int, int, int);
    callback router-add();
    padding-top: 6px;
    spacing: 8px;
    for r[i] in root.rows: Card {
        HorizontalLayout {
            padding: 14px;
            spacing: 12px;
            // Indicatore di volume: picco della sorgente negli ultimi 100 ms (0-1, scala in dB).
            Rectangle {
                width: 6px;
                border-radius: 3px;
                background: Theme.selected;
                Rectangle {
                    y: parent.height - self.height;
                    width: parent.width;
                    height: parent.height * root.levels[i];
                    // Tra una lettura e l'altra (100 ms) la barra scorre invece di saltare.
                    animate height { duration: 100ms; }
                    border-radius: 3px;
                    background: root.levels[i] > 0.97 ? Theme.error : Theme.meter;
                }
            }
            VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 12px;
                        background: Theme.selected;
                        Text { text: i + 1; font-size: 12px; color: Theme.text-secondary; }
                    }
                    LineEdit {
                        text: r.name;
                        placeholder-text: T.placeholder-name;
                        width: 220px;
                        edited(t) => { root.changed(i, { name: t, kind: r.kind, target: r.target, volume: r.volume, delay: r.delay, pick: r.pick, mono: r.mono }); }
                    }
                    ComboBox {
                        model: [T.kind-app, T.kind-input, T.kind-output, T.kind-except];
                        current-index: r.kind;
                        width: 220px;
                        selected(v) => {
                            root.changed(i, { name: r.name, kind: self.current-index, target: "", volume: r.volume, delay: r.delay, pick: 0, mono: r.mono });
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton { icon: "\u{E70E}"; enabled: i > 0; clicked => { root.move(i, -1); } }
                    IconButton { icon: "\u{E70D}"; enabled: i < root.rows.length - 1; clicked => { root.move(i, 1); } }
                    IconButton { icon: "\u{E74D}"; clicked => { root.remove(i); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    // App e «tutto tranne un'app»: eseguibile scritto o scelto tra le app aperte.
                    if r.kind == 0 || r.kind == 3: HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 1;
                        LineEdit {
                            text: r.target;
                            placeholder-text: T.placeholder-app;
                            horizontal-stretch: 1;
                            edited(t) => { root.changed(i, { name: r.name, kind: r.kind, target: t, volume: r.volume, delay: r.delay, pick: r.pick, mono: r.mono }); }
                        }
                        ComboBox {
                            model: root.app-choices;
                            current-index: 0;
                            width: 200px;
                            selected(v) => {
                                if (self.current-index > 0) {
                                    root.pick(i, r.kind, self.current-index);
                                }
                                self.current-index = 0;
                            }
                        }
                    }
                    // Ingresso e uscita: il dispositivo per nome, il predefinito di Windows in testa.
                    if r.kind == 1 || r.kind == 2: HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 1;
                        ComboBox {
                            model: r.kind == 1 ? root.inputs : root.outputs;
                            current-index: r.pick;
                            horizontal-stretch: 1;
                            selected(v) => { root.pick(i, r.kind, self.current-index); }
                        }
                        if r.pick < 0: Text { text: T.device-missing; color: Theme.error; vertical-alignment: center; }
                    }
                }
                // Volume e ritardo.
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: T.col-volume; color: Theme.text-secondary; vertical-alignment: center; }
                    Slider {
                        minimum: 0;
                        maximum: 200;
                        value: r.volume * 100;
                        width: 200px;
                        changed(v) => { root.changed(i, { name: r.name, kind: r.kind, target: r.target, volume: Math.round(v) / 100, delay: r.delay, pick: r.pick, mono: r.mono }); }
                    }
                    Text { text: Math.round(r.volume * 100) + "%"; width: 40px; color: Theme.text; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: T.mono; color: Theme.text-secondary; vertical-alignment: center; }
                    Switch {
                        checked: r.mono;
                        toggled => { root.changed(i, { name: r.name, kind: r.kind, target: r.target, volume: r.volume, delay: r.delay, pick: r.pick, mono: self.checked }); }
                    }
                    Rectangle { width: 16px; }
                    Text { text: T.col-delay; color: Theme.text-secondary; vertical-alignment: center; }
                    SpinBox {
                        minimum: -1000;
                        maximum: 1000;
                        step-size: 10;
                        value: r.delay;
                        width: 110px;
                        edited(v) => { root.changed(i, { name: r.name, kind: r.kind, target: r.target, volume: r.volume, delay: v, pick: r.pick, mono: r.mono }); }
                    }
                    Text { text: "ms"; color: Theme.text-secondary; vertical-alignment: center; }
                }
            }
        }
    }
    HorizontalLayout {
        alignment: start;
        Button { text: T.add-source; enabled: root.rows.length < 8; clicked => { root.add(); } }
        if root.router-available: Button { text: T.add-router; enabled: root.rows.length < 8; clicked => { root.router-add(); } }
    }
}

export component SettingsWindow inherits Window {
    title: T.window-title;
    icon: @image-url("../../../assets/icon/cliprec-256.png");
    preferred-width: 1060px;
    preferred-height: 720px;
    min-width: 920px;
    min-height: 600px;
    background: Theme.window;

    in-out property <Form> f;
    // Sorgenti delle clip video e delle clip solo audio.
    in-out property <[SourceRow]> sources;
    in-out property <[SourceRow]> audio-sources;
    // Livelli delle sorgenti dei due elenchi, per gli indicatori di volume.
    in property <[float]> levels-video;
    in property <[float]> levels-audio;
    in property <[string]> monitors;
    in property <[string]> windows-list;
    in property <[string]> apps;
    // Menu della scheda Audio: «Scegli…» in testa alle app, il predefinito in testa ai dispositivi.
    in property <[string]> app-choices;
    in property <[string]> inputs;
    in property <[string]> outputs;
    in property <string> ram-estimate;
    in property <string> hotkey-warning;
    in property <string> message;
    in property <bool> message-error;
    in property <string> status-text;
    in property <bool> status-online;
    in property <int> start-tab;
    in property <[string]> codec-labels;
    in-out property <int> codec-pos;
    in property <string> codec-warning;
    in property <string> version;
    in-out property <int> page: root.start-tab;

    callback save();
    callback cancel();
    callback test-clip();
    callback browse-folder();
    callback language-changed();
    // Il primo argomento è l'elenco: 0 = clip video, 1 = clip solo audio.
    callback source-changed(int, int, SourceRow);
    callback source-add(int);
    callback router-add(int);
    in property <bool> router-available;
    in property <bool> router-available-audio;
    callback source-remove(int, int);
    callback source-move(int, int, int);
    callback source-pick(int, int, int, int);
    callback video-target-pick(int);
    callback codec-picked(int);
    callback hotkey-key(int, string, bool, bool, bool, bool) -> bool;
    callback hotkey-mouse(int, int, bool, bool, bool, bool) -> bool;
    callback check-updates();
    in property <string> update-line;

    HorizontalLayout {
        // Barra laterale: nome, sezioni, stato del registratore.
        VerticalLayout {
            width: 264px;
            padding: 12px;
            padding-top: 18px;
            spacing: 4px;
            HorizontalLayout {
                padding-left: 12px;
                padding-bottom: 18px;
                spacing: 12px;
                Image {
                    source: @image-url("../../../assets/icon/cliprec-64.png");
                    width: 32px;
                    height: 32px;
                }
                VerticalLayout {
                    alignment: center;
                    Text { text: "ClipRec"; font-size: 16px; font-weight: 600; color: Theme.text; }
                    Text { text: T.app-subtitle; font-size: 12px; color: Theme.text-secondary; }
                }
            }
            NavItem { icon: "\u{E714}"; text: T.tab-video; selected: root.page == 0; clicked => { root.page = 0; } }
            NavItem { icon: "\u{E8D6}"; text: T.tab-audio-clip; selected: root.page == 1; clicked => { root.page = 1; } }
            NavItem { icon: "\u{E767}"; text: T.tab-audio; selected: root.page == 2; clicked => { root.page = 2; } }
            NavItem { icon: "\u{E713}"; text: T.tab-general; selected: root.page == 3; clicked => { root.page = 3; } }
            NavItem { icon: "\u{E946}"; text: T.tab-about; selected: root.page == 4; clicked => { root.page = 4; } }
            Rectangle { vertical-stretch: 1; }
            // Stato dal vivo (named pipe verso il core) e clip di prova.
            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.status-online ? Theme.success : Theme.text-disabled;
                            }
                        }
                        Text {
                            text: root.status-online ? T.status-running : T.status-offline;
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.text;
                        }
                    }
                    if root.status-online: Text {
                        text: root.status-text;
                        font-size: 12px;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                    Button {
                        text: T.test;
                        enabled: root.status-online;
                        clicked => { root.test-clip(); }
                    }
                }
            }
        }

        // Pagina scelta e barra dei pulsanti.
        VerticalLayout {
            horizontal-stretch: 1;
            if root.page == 0: Page {
                vertical-stretch: 1;
                title: T.tab-video;
                subtitle: T.video-subtitle;
                SectionTitle { text: T.sec-recording; }
                Card {
                    SettingRow {
                        title: T.video-enabled;
                        description: T.video-enabled-desc;
                        Switch { checked <=> root.f.video-enabled; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.video-source;
                        description: T.video-source-desc;
                        enabled: root.f.video-enabled;
                        ComboBox {
                            model: [T.auto, T.src-monitor, T.src-window, T.src-game];
                            current-index <=> root.f.source-kind;
                            enabled: root.f.video-enabled;
                            width: 220px;
                        }
                    }
                    if root.f.source-kind > 0: Divider { }
                    if root.f.source-kind > 0: SettingRow {
                        title: T.video-target;
                        description: root.f.source-kind == 1 ? T.target-monitor-desc : (root.f.source-kind == 2 ? T.target-window-desc : T.target-game-desc);
                        enabled: root.f.video-enabled;
                        LineEdit { text <=> root.f.source-target; enabled: root.f.video-enabled; width: 220px; }
                        ComboBox {
                            model: root.f.source-kind == 1 ? root.monitors : (root.f.source-kind == 2 ? root.windows-list : root.apps);
                            current-index: -1;
                            enabled: root.f.video-enabled;
                            width: 160px;
                            selected(v) => {
                                root.video-target-pick(self.current-index);
                                self.current-index = -1;
                            }
                        }
                    }
                }
                SectionTitle { text: T.sec-quality; }
                Card {
                    SettingRow {
                        title: T.video-codec;
                        description: root.codec-warning != "" ? root.codec-warning : T.video-codec-desc;
                        description-color: root.codec-warning != "" ? Theme.warning : Theme.text-secondary;
                        ComboBox {
                            model: root.codec-labels;
                            current-index <=> root.codec-pos;
                            selected(v) => { root.codec-picked(self.current-index); }
                            width: 220px;
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: T.video-resolution;
                        description: T.video-resolution-desc;
                        ComboBox { model: [T.native, "1440p", "1080p", "720p"]; current-index <=> root.f.resolution; width: 220px; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.video-fps;
                        ComboBox { model: ["30", "60", "120", "144"]; current-index <=> root.f.fps; width: 220px; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.video-quality;
                        description: T.video-quality-desc;
                        Slider {
                            minimum: 10;
                            maximum: 40;
                            value: root.f.quality;
                            changed(v) => { root.f.quality = Math.round(v); }
                            width: 180px;
                        }
                        Text { text: root.f.quality; width: 32px; color: Theme.text; vertical-alignment: center; horizontal-alignment: right; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.video-max-bitrate;
                        description: T.video-max-bitrate-desc;
                        LineEdit { text <=> root.f.max-bitrate; placeholder-text: T.auto; width: 220px; }
                    }
                }
                SectionTitle { text: T.sec-capture; }
                Card {
                    SettingRow {
                        title: T.capture-cursor;
                        Switch { checked <=> root.f.capture-cursor; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.any-fullscreen;
                        description: T.any-fullscreen-desc;
                        Switch { checked <=> root.f.any-fullscreen; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.games;
                        description: T.games-hint;
                        LineEdit { text <=> root.f.games; width: 300px; }
                    }
                }
                SectionTitle { text: T.sec-encoding; }
                Card {
                    SettingRow {
                        title: T.color-format;
                        description: T.color-format-desc;
                        ComboBox { model: [T.fmt-420, T.fmt-444]; current-index <=> root.f.color-format; width: 220px; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.rate-control;
                        description: T.rate-control-desc;
                        ComboBox { model: [T.rc-quality, T.rc-vbr, T.rc-cbr]; current-index <=> root.f.rate-control; width: 220px; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.target-bitrate;
                        description: T.target-bitrate-desc;
                        enabled: root.f.rate-control > 0;
                        LineEdit { text <=> root.f.target-bitrate; placeholder-text: T.auto; enabled: root.f.rate-control > 0; width: 220px; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.preset;
                        description: T.preset-desc;
                        ComboBox {
                            model: [T.preset-fastest, T.preset-fast, T.preset-balanced, T.preset-quality, T.preset-best];
                            current-index <=> root.f.preset;
                            width: 220px;
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: T.keyframe;
                        description: T.keyframe-desc;
                        SpinBox { minimum: 1; maximum: 10; value <=> root.f.keyframe-seconds; width: 140px; }
                        Text { text: T.seconds; color: Theme.text-secondary; vertical-alignment: center; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.b-frames;
                        description: T.b-frames-desc;
                        ComboBox { model: [T.auto, "0", "1", "2", "3", "4"]; current-index <=> root.f.b-frames; width: 220px; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.lookahead;
                        description: T.lookahead-desc;
                        Switch { checked <=> root.f.lookahead; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.aq;
                        description: T.aq-desc;
                        Switch { checked <=> root.f.adaptive-quantization; }
                    }
                }
                SectionTitle { text: T.sec-length-files; }
                Card {
                    SettingRow {
                        title: T.clip-video-seconds;
                        description: T.clip-video-seconds-desc;
                        SpinBox { minimum: 1; maximum: 3600; value <=> root.f.video-seconds; width: 140px; }
                        Text { text: T.seconds; color: Theme.text-secondary; vertical-alignment: center; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.container;
                        description: T.container-desc;
                        ComboBox { model: ["MP4", "MKV"]; current-index <=> root.f.container; width: 240px; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.audio-bitrate;
                        description: T.audio-bitrate-desc;
                        ComboBox { model: ["96 kbit/s", "128 kbit/s", "160 kbit/s", "192 kbit/s", "256 kbit/s", "320 kbit/s"]; current-index <=> root.f.audio-bitrate; width: 240px; }
                    }
                }
                SectionTitle { text: T.sec-tracks-short; }
                Card {
                    SettingRow {
                        title: T.audio-mode;
                        description: T.audio-mode-desc;
                        ComboBox { model: [T.mode-separate, T.mode-merged]; current-index <=> root.f.audio-mode; width: 240px; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.add-mix;
                        description: T.add-mix-desc;
                        enabled: root.f.audio-mode == 0;
                        Switch { checked <=> root.f.add-mix; enabled: root.f.audio-mode == 0; }
                    }
                }
                SectionTitle { text: T.sec-sources; }
                Text { text: T.sources-hint; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; }
                SourceList {
                    rows: root.sources;
                    levels: root.levels-video;
                    app-choices: root.app-choices;
                    inputs: root.inputs;
                    outputs: root.outputs;
                    router-available: root.router-available;
                    changed(i, r) => { root.source-changed(0, i, r); }
                    add => { root.source-add(0); }
                    remove(i) => { root.source-remove(0, i); }
                    move(i, d) => { root.source-move(0, i, d); }
                    pick(i, k, x) => { root.source-pick(0, i, k, x); }
                    router-add => { root.router-add(0); }
                }
                SectionTitle { text: T.sec-shortcuts; }
                Card {
                    SettingRow {
                        title: T.hotkey-video;
                        description: T.hotkey-video-desc;
                        HotkeyField {
                            value: root.f.hotkey-video;
                            key(t, c, a, s, m) => { root.hotkey-key(0, t, c, a, s, m) }
                            mouse(b, c, a, s, m) => { root.hotkey-mouse(0, b, c, a, s, m) }
                        }
                        IconButton { icon: "\u{E711}"; enabled: root.f.hotkey-video != ""; clicked => { root.f.hotkey-video = ""; } }
                    }
                    Divider { }
                    SettingRow {
                        title: T.pad-video;
                        LineEdit { text <=> root.f.pad-video; placeholder-text: "Back+A"; width: 220px; }
                    }
                }
                Text { text: T.hotkey-hint; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; }
                if root.hotkey-warning != "": Text { text: root.hotkey-warning; font-size: 12px; color: Theme.warning; wrap: word-wrap; }
                Text { text: T.pad-hint; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; }
            }

            if root.page == 1: Page {
                vertical-stretch: 1;
                title: T.tab-audio-clip;
                subtitle: T.audio-clip-subtitle;
                SectionTitle { text: T.sec-length-format; }
                Card {
                    SettingRow {
                        title: T.clip-audio-seconds;
                        description: T.clip-audio-seconds-desc;
                        SpinBox { minimum: 1; maximum: 7200; value <=> root.f.audio-seconds; width: 140px; }
                        Text { text: T.seconds; color: Theme.text-secondary; vertical-alignment: center; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.audio-format;
                        ComboBox { model: [T.fmt-flac, T.fmt-wav, T.fmt-mka, T.fmt-polywav, T.fmt-opus, T.fmt-aac, T.fmt-mp3]; current-index <=> root.f.audio-format; width: 240px; }
                    }
                }
                SectionTitle { text: T.sec-tracks-short; }
                Card {
                    SettingRow {
                        title: T.audio-mode;
                        description: T.audio-mode-desc;
                        ComboBox { model: [T.mode-separate, T.mode-merged]; current-index <=> root.f.audio-clip-mode; width: 240px; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.add-mix;
                        description: T.add-mix-desc;
                        enabled: root.f.audio-clip-mode == 0;
                        Switch { checked <=> root.f.audio-clip-add-mix; enabled: root.f.audio-clip-mode == 0; }
                    }
                }
                SectionTitle { text: T.sec-sources; }
                Text { text: T.sources-hint; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; }
                SourceList {
                    rows: root.audio-sources;
                    levels: root.levels-audio;
                    app-choices: root.app-choices;
                    inputs: root.inputs;
                    outputs: root.outputs;
                    router-available: root.router-available-audio;
                    changed(i, r) => { root.source-changed(1, i, r); }
                    add => { root.source-add(1); }
                    remove(i) => { root.source-remove(1, i); }
                    move(i, d) => { root.source-move(1, i, d); }
                    pick(i, k, x) => { root.source-pick(1, i, k, x); }
                    router-add => { root.router-add(1); }
                }
                SectionTitle { text: T.sec-shortcuts; }
                Card {
                    SettingRow {
                        title: T.hotkey-audio;
                        description: T.hotkey-audio-desc;
                        HotkeyField {
                            value: root.f.hotkey-audio;
                            key(t, c, a, s, m) => { root.hotkey-key(1, t, c, a, s, m) }
                            mouse(b, c, a, s, m) => { root.hotkey-mouse(1, b, c, a, s, m) }
                        }
                        IconButton { icon: "\u{E711}"; enabled: root.f.hotkey-audio != ""; clicked => { root.f.hotkey-audio = ""; } }
                    }
                    Divider { }
                    SettingRow {
                        title: T.pad-audio;
                        LineEdit { text <=> root.f.pad-audio; placeholder-text: "LB+RB+Y"; width: 220px; }
                    }
                }
                Text { text: T.hotkey-hint; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; }
                if root.hotkey-warning != "": Text { text: root.hotkey-warning; font-size: 12px; color: Theme.warning; wrap: word-wrap; }
                Text { text: T.pad-hint; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; }
            }

            if root.page == 2: Page {
                vertical-stretch: 1;
                title: T.tab-audio;
                subtitle: T.audio-subtitle;
                SectionTitle { text: T.sec-apps; }
                Card {
                    SettingRow {
                        title: T.process-events;
                        description: T.process-events-desc;
                        Switch { checked <=> root.f.process-events; }
                    }
                    SettingRow {
                        title: T.block-exclusive;
                        description: T.block-exclusive-desc;
                        Switch { checked <=> root.f.block-exclusive; }
                    }
                }
            }

            if root.page == 3: Page {
                vertical-stretch: 1;
                title: T.tab-general;
                subtitle: T.general-subtitle;
                SectionTitle { text: T.sec-files; }
                Card {
                    SettingRow {
                        title: T.folder;
                        LineEdit { text <=> root.f.folder; placeholder-text: T.folder-default; width: 320px; }
                        Button { text: T.browse; clicked => { root.browse-folder(); } }
                    }
                    Divider { }
                    SettingRow {
                        title: T.template;
                        description: T.template-hint;
                        LineEdit { text <=> root.f.template; width: 320px; }
                    }
                }
                SectionTitle { text: T.sec-startup; }
                Card {
                    SettingRow {
                        title: T.start-windows;
                        description: T.start-windows-desc;
                        Switch { checked <=> root.f.start-with-windows; }
                    }
                    Divider { }
                    // Disponibile solo con l'avvio con Windows: senza, resta spento e grigio.
                    SettingRow {
                        title: T.start-admin;
                        description: T.start-admin-desc;
                        enabled: root.f.start-with-windows;
                        Switch {
                            checked: root.f.start-with-windows && root.f.start-as-admin;
                            enabled: root.f.start-with-windows;
                            toggled => { root.f.start-as-admin = self.checked; }
                        }
                    }
                }
                SectionTitle { text: T.sec-notify; }
                Card {
                    SettingRow {
                        title: T.notifications;
                        description: T.notifications-desc;
                        Switch { checked <=> root.f.notifications; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.sound;
                        description: T.sound-desc;
                        Switch { checked <=> root.f.sound; }
                    }
                }
                SectionTitle { text: T.sec-memory; }
                Card {
                    SettingRow {
                        title: T.ram-max;
                        description: T.ram-max-desc + "  " + T.ram-estimate + ": " + root.ram-estimate;
                        LineEdit { text <=> root.f.max-mb; placeholder-text: T.ram-auto; width: 220px; }
                    }
                    Divider { }
                    SettingRow {
                        title: T.lock-pages;
                        description: T.lock-pages-desc;
                        Switch { checked <=> root.f.lock-pages; }
                    }
                }
                SectionTitle { text: T.sec-performance; }
                Card {
                    SettingRow {
                        title: T.gpu-priority;
                        description: T.gpu-priority-desc;
                        ComboBox { model: [T.prio-high, T.prio-normal]; current-index <=> root.f.gpu-priority; width: 220px; }
                    }
                }
                SectionTitle { text: T.sec-language; }
                Card {
                    SettingRow {
                        title: T.language;
                        ComboBox {
                            model: [T.lang-auto, "Italiano", "English"];
                            current-index <=> root.f.language;
                            width: 220px;
                            selected(v) => { root.language-changed(); }
                        }
                    }
                }
            }

            if root.page == 4: Page {
                vertical-stretch: 1;
                title: T.tab-about;
                subtitle: T.about-subtitle;
                SectionTitle { text: "ClipRec"; }
                Card {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 6px;
                        Text { text: T.version + " " + root.version; font-size: 12px; color: Theme.text-secondary; }
                        Text { text: T.about-text; font-size: 14px; color: Theme.text; wrap: word-wrap; }
                    }
                }
                SectionTitle { text: T.sec-updates; }
                Card {
                    SettingRow {
                        title: T.version + " " + root.version;
                        description: root.update-line;
                        Button { text: T.check-now; clicked => { root.check-updates(); } }
                    }
                    Divider { }
                    SettingRow {
                        title: T.check-updates;
                        description: T.check-updates-desc;
                        Switch { checked <=> root.f.check-updates; }
                    }
                }
                VerticalLayout {
                    padding-top: 16px;
                    alignment: start;
                    HorizontalLayout {
                        alignment: start;
                        AboutSlint { width: 220px; height: 110px; }
                    }
                }
            }

            // Messaggio dell'ultima azione e pulsanti.
            Divider { }
            HorizontalLayout {
                padding-left: 36px;
                padding-right: 24px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 8px;
                Text {
                    text: root.message;
                    font-size: 13px;
                    color: root.message-error ? Theme.error : Theme.success;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                Button { text: T.cancel; width: 120px; clicked => { root.cancel(); } }
                Button { text: T.save; primary: true; width: 120px; clicked => { root.save(); } }
            }
        }
    }
    // Il renderer software, dopo riduci/ripristina, ridisegna solo le zone cambiate ma Windows ha
    // già svuotato il buffer: la finestra resta trasparente. Cambiare questo velo invisibile
    // (alfa 1/255) dal codice rende sporca tutta la finestra e la ridisegna intera.
    in property <bool> repaint;
    Rectangle { x: 0; y: 0; width: root.width; height: root.height; background: root.repaint ? #00000001 : #00000000; }
}

// Finestra di aggiornamento (`cliprec-settings --aggiornamento`): stesso tema delle impostazioni.
// Testi e stato arrivano da Rust (src/update_window.rs), che segue il core sulla named pipe.
export component UpdateWindow inherits Window {
    in property <string> window-title: "ClipRec";
    title: root.window-title;
    icon: @image-url("../../../assets/icon/cliprec-256.png");
    preferred-width: 560px;
    preferred-height: 480px;
    min-width: 460px;
    min-height: 300px;
    background: Theme.window;

    in property <string> heading;
    in property <string> subheading;
    in property <string> notes-title;
    in property <string> notes;
    in property <string> status;
    in property <bool> status-error;
    in property <bool> busy;
    in property <bool> can-install;
    in property <string> install-text;
    in property <string> close-text;
    in property <float> progress: -1;
    callback install();
    callback dismiss();

    VerticalLayout {
        padding: 28px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 16px;
            Image {
                source: @image-url("../../../assets/icon/cliprec-128.png");
                width: 56px;
                height: 56px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text { text: root.heading; font-size: 20px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                Text { text: root.subheading; font-size: 13px; color: Theme.text-secondary; wrap: word-wrap; }
            }
        }
        if root.notes != "": VerticalLayout {
            vertical-stretch: 1;
            spacing: 6px;
            Text { text: root.notes-title; font-size: 14px; font-weight: 600; color: Theme.text; }
            Card {
                vertical-stretch: 1;
                ScrollView {
                    VerticalLayout {
                        padding: 14px;
                        Text { text: root.notes; font-size: 13px; color: Theme.text; wrap: word-wrap; }
                    }
                }
            }
        }
        if root.notes == "": Rectangle { vertical-stretch: 1; }
        if root.progress >= 0: ProgressIndicator { progress: root.progress; height: 6px; }
        HorizontalLayout {
            spacing: 10px;
            if root.busy: Spinner { width: 20px; height: 20px; indeterminate: true; }
            Text {
                text: root.status;
                font-size: 13px;
                color: root.status-error ? Theme.error : Theme.text-secondary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
            Button { text: root.close-text; width: 130px; clicked => { root.dismiss(); } }
            if root.can-install: Button {
                text: root.install-text;
                primary: true;
                enabled: !root.busy;
                width: 170px;
                clicked => { root.install(); }
            }
        }
    }
    // Il renderer software, dopo riduci/ripristina, ridisegna solo le zone cambiate ma Windows ha
    // già svuotato il buffer: la finestra resta trasparente. Cambiare questo velo invisibile
    // (alfa 1/255) dal codice rende sporca tutta la finestra e la ridisegna intera.
    in property <bool> repaint;
    Rectangle { x: 0; y: 0; width: root.width; height: root.height; background: root.repaint ? #00000001 : #00000000; }
}
